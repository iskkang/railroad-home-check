{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/geocode.js": {
      "maxDuration": 20
    },
    "api/flood.js": {
      "maxDuration": 20
    },
    "api/roadnames.js": {
      "maxDuration": 20
    },
    "api/risk.js": {
      "maxDuration": 15
    }
  }
}